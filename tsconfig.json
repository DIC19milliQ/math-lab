{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["vite-env.d.ts", "main.tsx", "app/**/*.ts", "app/**/*.tsx", "components/ui/button.tsx", "lib/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
